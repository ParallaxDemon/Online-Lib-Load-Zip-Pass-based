<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PARALLAX  /  LIBRARY" android:textColor="@color/accent"
            android:textSize="13sp" android:letterSpacing="0.18" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Online library loader"
            android:textColor="@color/foreground" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Download, extract and load your configured archive."
            android:textColor="@color/muted" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="36dp" android:padding="24dp" android:orientation="vertical"
            android:background="@drawable/panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="STATUS" android:textColor="@color/accent" android:letterSpacing="0.15" />
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Waiting to start" android:textColor="@color/foreground" android:textSize="19sp" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="3dp"
                android:layout_marginTop="20dp" android:indeterminate="true" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/action" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="28dp"
            android:text="RELOAD ARCHIVE" android:textAllCaps="false"
            android:textColor="@color/background" android:backgroundTint="@color/accent" />
    </LinearLayout>
</ScrollView>
