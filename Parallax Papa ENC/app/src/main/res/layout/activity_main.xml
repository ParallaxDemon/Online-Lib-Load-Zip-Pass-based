<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PARALLAX  /  CONFIG" android:textColor="@color/accent"
            android:textSize="13sp" android:letterSpacing="0.18" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Archive configuration"
            android:textColor="@color/foreground" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Generate a JSON file for the loader assets."
            android:textColor="@color/muted" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:padding="20dp" android:orientation="vertical"
            android:background="@drawable/panel">
            <EditText android:id="@+id/url" android:layout_width="match_parent"
                android:layout_height="56dp" android:hint="HTTPS ZIP URL"
                android:inputType="textUri" android:singleLine="true" android:textColor="@color/foreground"
                android:textColorHint="@color/muted" />
            <EditText android:id="@+id/password" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="12dp"
                android:hint="ZIP password" android:inputType="textPassword"
                android:textColor="@color/foreground" android:textColorHint="@color/muted" />
        </LinearLayout>
        <Button android:id="@+id/generate" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="24dp"
            android:text="GENERATE JSON" android:textAllCaps="false"
            android:textColor="@color/background" android:backgroundTint="@color/accent" />
        <Button android:id="@+id/copy" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="8dp"
            android:text="COPY JSON" android:textAllCaps="false" />
        <TextView android:id="@+id/result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:padding="20dp" android:background="@drawable/panel"
            android:text="Generated JSON appears here" android:textColor="@color/foreground"
            android:textSize="14sp" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
